# File ini adalah contoh untuk konfigurasi bot Anda.
# Salin file ini ke .env (cp .env.example .env) dan isi nilainya.
# Jangan pernah membagikan file .env Anda yang sudah diisi.

# --- WAJIB DIISI ---

# Token bot Telegram Anda.
# Dapatkan dari @BotFather di Telegram dengan membuat bot baru.
TELEGRAM_TOKEN="ISI_TOKEN_ANDA_DISINI"


# --- OPSIONAL (Tapi Direkomendasikan) ---

# Kunci API untuk Google Gemini.
# Diperlukan untuk semua fitur AI, seperti /edit_ai, /toanime, dll.
# Anda bisa mendapatkannya secara gratis dari Google AI Studio.
# Jika dikosongkan, fitur AI akan dinonaktifkan secara otomatis.
GEMINI_API_KEY=""
